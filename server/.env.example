NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitsync
DB_PASSWORD=
DB_NAME=fitsync
DB_POOL_SIZE=10

# Signs and verifies FitSync JWTs. Set this in your own .env, not here — it
# must be long and random, and must never be committed: anyone holding it can
# mint a valid token for any user.
JWT_SECRET=

# stub | http. stub accepts a small set of fixed test tokens and must never be
# used in production — see the startup guard in src/config/index.js.
GOOGLE_MODE=stub
# The OAuth 2.0 client ID Google ID tokens are verified against.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# stub | smtp | brevo. stub logs each email, including its verification or
# password-reset code, to the console instead of sending it — fine for local
# development, where you read the code from the log and type it into the app.
# smtp sends real mail via the SMTP_* keys and MAIL_FROM below;
# brevo sends it through Brevo's HTTPS API with BREVO_API_KEY and MAIL_FROM. The
# server refuses to boot with MAIL_MODE=stub (or unset) in production, because
# verification is a hard gate: nobody could otherwise register. See
# docs/production.md.
MAIL_MODE=stub
# Base URL for links that leave the app — today only the shared coach-report
# link (verification and password reset use emailed codes, not links). Defaults
# to http://localhost:3000 if unset; set it to the public origin in production,
# where a localhost value is refused at startup.
PUBLIC_BASE_URL=
# Required only when MAIL_MODE=smtp. See docs/production.md and TODO-dave.md
# for setup steps.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Required when MAIL_MODE=smtp or MAIL_MODE=brevo: "Name <address>" or a bare
# address. With brevo it must be a sender verified in Brevo.
MAIL_FROM=
# Required only when MAIL_MODE=brevo: an API key from Brevo -> SMTP & API ->
# API Keys (starts xkeysib-), not the SMTP key (xsmtpsib-).
BREVO_API_KEY=

ML_MODE=stub
ML_SERVICE_URL=

STORAGE_MODE=local
STORAGE_LOCAL_DIR=storage

GROQ_API_KEY=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
