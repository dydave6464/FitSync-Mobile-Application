NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitsync
DB_PASSWORD=
DB_NAME=fitsync
DB_POOL_SIZE=10

# Signs and verifies FitSync JWTs. Set this in your own .env, not here — it
# must be long and random, and must never be committed: anyone holding it can
# mint a valid token for any user.
JWT_SECRET=

# stub | http. stub accepts a small set of fixed test tokens and must never be
# used in production — see the startup guard in src/config/index.js.
GOOGLE_MODE=stub
# The OAuth 2.0 client ID Google ID tokens are verified against.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

ML_MODE=stub
ML_SERVICE_URL=

STORAGE_MODE=local
STORAGE_LOCAL_DIR=storage

GROQ_API_KEY=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
