NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitsync
DB_PASSWORD=
DB_NAME=fitsync
DB_POOL_SIZE=10

# Signs and verifies FitSync JWTs. Set this in your own .env, not here — it
# must be long and random, and must never be committed: anyone holding it can
# mint a valid token for any user.
JWT_SECRET=

# stub | http. stub accepts a small set of fixed test tokens and must never be
# used in production — see the startup guard in src/config/index.js.
GOOGLE_MODE=stub
# The OAuth 2.0 client ID Google ID tokens are verified against.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# stub | smtp. stub logs the verification/password-reset link to the console
# instead of sending it — fine for local development, where you click the
# logged link. smtp sends real mail via the five SMTP_* keys below. The
# server refuses to boot with MAIL_MODE=stub (or unset) in production, because
# verification is a hard gate: nobody could otherwise register. See
# docs/production.md.
MAIL_MODE=stub
# Base URL used to build the links this mails out (e.g. .../auth/verify-email
# and the password-reset form). Defaults to http://localhost:3000 if unset;
# set it to the real public origin in production.
PUBLIC_BASE_URL=
# Required only when MAIL_MODE=smtp. See docs/production.md and TODO-dave.md
# for setup steps.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

ML_MODE=stub
ML_SERVICE_URL=

STORAGE_MODE=local
STORAGE_LOCAL_DIR=storage

GROQ_API_KEY=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
