# Read-only credentials for the ML service. Create this account with the grant
# documented in server/MIGRATIONS.md -- it must NOT be the app's DB user.
FITSYNC_DB_HOST=127.0.0.1
FITSYNC_DB_PORT=3306
FITSYNC_DB_USER=fitsync_ml
FITSYNC_DB_PASSWORD=
FITSYNC_DB_NAME=fitsync

# Which database `pytest` reads and writes. Separate from FITSYNC_DB_NAME on
# purpose: the test fixtures INSERT and DELETE, and FITSYNC_DB_NAME above
# points at the live catalogue. The suite refuses any name not ending `_test`.
#
# `fitsync_ml_test` is deliberately NOT the Node suite's `fitsync_test`, which
# server/tests/helpers/test-db.js drops wholesale -- sharing it meant `npm test`
# silently disabled every DB-backed test here. Create it once; see ml/README.md.
FITSYNC_TEST_DB_NAME=fitsync_ml_test

# Set in CI. Makes an unusable test database FAIL the run instead of skipping
# it -- pytest exits 0 on a skip, so without this a suite that stopped covering
# anything still reports success.
# FITSYNC_TEST_REQUIRE_DB=1

# Where a trained model would live. Absent is normal and expected today.
FITSYNC_MODEL_DIR=models
FITSYNC_LOG_LEVEL=info
