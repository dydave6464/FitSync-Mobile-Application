# Read-only credentials for the ML service. Create this account with the grant
# documented in server/MIGRATIONS.md -- it must NOT be the app's DB user.
FITSYNC_DB_HOST=127.0.0.1
FITSYNC_DB_PORT=3306
FITSYNC_DB_USER=fitsync_ml
FITSYNC_DB_PASSWORD=
FITSYNC_DB_NAME=fitsync

# Where a trained model would live. Absent is normal and expected today.
FITSYNC_MODEL_DIR=models
FITSYNC_LOG_LEVEL=info
